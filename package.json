{
  "name": "human-picker-server",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first human decision inbox for AI agents, scripts, and MCP clients.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && vue-tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.0",
    "vue": "^3.5.20",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vue-tsc": "^3.1.0"
  }
}
